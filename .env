# API anime — dipakai lewat jalur same-origin (tanpa CORS proxy).
# Di production (Vercel) path /api di-proxy server-side lewat vercel.json;
# di dev, vite proxy meneruskan /api ke upstream. Jadi request API tidak lagi
# bergantung pada CORS proxy pihak ketiga yang lambat/unreliable.
VITE_API_BASE=/api
# CORS proxy untuk API anime — server API tidak mengirim header CORS,
# jadi request browser harus lewat proxy. Default: Cloudflare Worker project.
# Boleh diganti proxy lain, atau isi "direct" untuk menonaktifkan proxy.
# Catatan: dengan VITE_API_BASE=/api, proxy ini hanya jadi FALLBACK saat
# jalur same-origin gagal (misal di host statis tanpa rewrite).
VITE_CORS_PROXY=https://cf.tiyanstores.workers.dev/?url=
# Kredensial Supabase Anda
VITE_SUPABASE_URL=https://hdthvmpbgaqprlqznrtt.supabase.co
